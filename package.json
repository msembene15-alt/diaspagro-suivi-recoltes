{
  "name": "diaspagro-suivi-recoltes",
  "version": "1.1.0",
  "description": "DIASPAGRO – Suivi et planning des récoltes (Sénégal)",
  "author": "DIASPAGRO",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.diaspagro.suivirecoltes",
    "productName": "DIASPAGRO Suivi Récoltes",
    "directories": { "output": "dist" },
    "files": ["main.js", "renderer/**/*", "build/icon.png"],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DIASPAGRO-Suivi-Recoltes-Setup.${ext}"
    }
  }
}
